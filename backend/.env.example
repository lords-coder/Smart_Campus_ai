# ---------------------------------------------------------------------------
# Backend configuration. Copy to .env and fill in the values.
# Secrets live here only; .env is git-ignored and this template is committed.
# ---------------------------------------------------------------------------

# --- required: database and signing key -------------------------------------
DATABASE_URL=postgresql://smartcampus:smartcampus_dev@localhost:5432/smartcampus
JWT_SECRET=replace-with-64-plus-random-characters
JWT_EXPIRES_IN=1d

# --- required: registration and approval ------------------------------------
# Only student, faculty and administrator accounts may register, and every one
# of them must be approved by SUPER_ADMIN before it can sign in.
UNIVERSITY_EMAIL_DOMAIN=example.edu
ADMIN_REGISTRATION_CODE=set-your-own-code
FACULTY_REGISTRATION_CODE=set-your-own-code

# --- required: the single SUPER_ADMIN bootstrap account ---------------------
# Read by `npm run seed` / `npm run bootstrap` only. The password is bcrypt
# hashed on the way in and is never stored or returned in plaintext.
SUPER_ADMIN_EMAIL=superadmin@example.edu
SUPER_ADMIN_PASSWORD=set-a-long-random-password

# --- optional ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
PORT=4000
BCRYPT_ROUNDS=10

# Rate limiting for the public auth endpoints (register, login, password help,
# password reset). The value is per client IP per window.
AUTH_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Phase 4 AI assistant. With no OPENAI_API_KEY the deterministic mock is used.
AI_PROVIDER=auto
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
AI_MAX_TOKENS=400
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=60000

# Phase 5 ML service (server-side only; the browser never calls it).
ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_MS=5000