{
  "name": "smartcampus-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SmartCampus AI backend API (modular monolith)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:test": "tsx src/scripts/seed-test.ts",
    "bootstrap": "tsx src/scripts/bootstrap.ts",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "test:api": "node tests/api.smoke.mjs",
    "test:ml": "node tests/ml-integration.mjs",
    "test:feature-parity": "tsx tests/feature-parity.mjs",
    "test:registration": "node tests/registration.flow.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
